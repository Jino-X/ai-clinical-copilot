# Reference of every environment variable in the project (PRD §25).
#
# This file is NOT loaded by anything. Each app reads its own file, so that a
# backend secret can never be pulled into the browser bundle by accident:
#
#   apps/web/.env.local   <- from apps/web/.env.example   (public values only)
#   apps/api/.env         <- from apps/api/.env.example   (secrets)

# ---------------------------------------------------------------------------
# Frontend — apps/web/.env.local
# Compiled into the client bundle. Public by definition.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Backend — apps/api/.env
# Never exposed to the frontend.
# ---------------------------------------------------------------------------
ENVIRONMENT=
LOG_LEVEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=

CORS_ALLOW_ORIGINS=

# Added in Phase 5 (AI) and Phase 9 (production). Only set the providers you
# actually use — an unset key is better than a placeholder one.
# LLM_PROVIDER=
# TRANSCRIPTION_PROVIDER=
# EMBEDDING_PROVIDER=
# OPENAI_API_KEY=
# AWS_REGION=
# SENTRY_DSN=
