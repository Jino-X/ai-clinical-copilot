# Copy to apps/api/.env — never commit the filled-in file.
# Everything here is server-side only and must never reach the browser.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Bypasses Row Level Security. Treat as a root credential.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database ---------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooled connection string for a serverless/containerised backend.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# --- HTTP -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- AI providers (Phase 5–8) ------------------------------------------------
# Set these to enable transcription, SOAP generation, patient intelligence,
# document extraction, and RAG.
# LLM_PROVIDER=openai
# TRANSCRIPTION_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=

# --- Local AI Integration (development only) ---------------------------------
# Use Ollama + Qwen3 8B for LLM, IndicConformer for STT, and local translation.
# Requires: Ollama installed (ollama.com), qwen3:8b pulled, and
# torch+torchaudio+transformers installed for IndicConformer.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_TIMEOUT_SECONDS=120
# TRANSCRIPTION_PROVIDER=indicconformer
# INDICCONFORMER_MODEL=ai4bharat/indic-conformer-600m-multilingual
# INDICCONFORMER_LANGUAGE=ta
# INDICCONFORMER_DECODER=ctc
# INDICCONFORMER_DEVICE=cpu
# TRANSLATION_PROVIDER=local

# --- AWS (Phase 9) ----------------------------------------------------------
# AWS_REGION=eu-west-1
# SENTRY_DSN=
